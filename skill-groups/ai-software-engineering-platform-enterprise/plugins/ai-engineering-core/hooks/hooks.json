{
  "description": "AI工程状态恢复、可中断控制和压缩前检查点。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/session_context.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\session_context.py\"",
            "statusMessage": "恢复AI工程上下文",
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/runtime_control.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\runtime_control.py\"",
            "statusMessage": "检查任务控制指令",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/precompact_snapshot.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\precompact_snapshot.py\"",
            "statusMessage": "压缩前保存工程状态",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/stop_snapshot.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\stop_snapshot.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/session_end.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\session_end.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
