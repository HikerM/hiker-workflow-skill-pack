{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiker.local/schemas/structural-change-decision.schema.json",
  "title": "Hiker Structural Change Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "action", "decision_scope", "problem_refs", "evidence_refs",
    "reason", "alternatives_rejected", "expected_gain", "migration_cost", "regression_risk",
    "rollback_or_exit_condition", "confidence"],
  "properties": {
    "schema_version": {
      "const": "hiker-structural-change-decision/v1"
    },
    "status": {
      "enum": ["VALIDATED", "NOT_APPLICABLE"]
    },
    "authority": {
      "const": "CHATGPT_SEMANTIC_SELECTION"
    },
    "runtime_selected_action": {
      "const": false
    },
    "action": {
      "enum": [
        "MODIFY_EXISTING",
        "INTRODUCE_ABSTRACTION",
        "CONSOLIDATE_SIMPLIFY",
        "DELETE_SAFELY",
        "KEEP_CURRENT_STRUCTURE"
      ]
    },
    "decision_scope": {"$ref": "#/$defs/nonEmptyRefs"},
    "problem_refs": {"$ref": "#/$defs/nonEmptyRefs"},
    "evidence_refs": {"$ref": "#/$defs/nonEmptyRefs"},
    "reason": {"$ref": "#/$defs/text"},
    "alternatives_rejected": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "reason"],
        "properties": {
          "action": {
            "enum": [
              "MODIFY_EXISTING",
              "INTRODUCE_ABSTRACTION",
              "CONSOLIDATE_SIMPLIFY",
              "DELETE_SAFELY",
              "KEEP_CURRENT_STRUCTURE"
            ]
          },
          "reason": {"$ref": "#/$defs/text"}
        }
      }
    },
    "expected_gain": {
      "allOf": [
        {"$ref": "#/$defs/detail"},
        {
          "properties": {
            "classification": {
              "enum": ["OBSERVED", "INFERRED", "EXPECTED"]
            }
          }
        }
      ]
    },
    "migration_cost": {"$ref": "#/$defs/levelDetail"},
    "regression_risk": {"$ref": "#/$defs/levelDetail"},
    "rollback_or_exit_condition": {"$ref": "#/$defs/text"},
    "confidence": {
      "enum": ["LOW", "MEDIUM", "HIGH"]
    },
    "evidence_grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_schema_version",
        "catalog_authority",
        "scope_fingerprint",
        "project_fact_fingerprint",
        "observed_fact_count",
        "referenced_fact_count",
        "claims"
      ],
      "properties": {
        "catalog_schema_version": {
          "const": "hiker-observed-fact-catalog/v1"
        },
        "catalog_authority": {
          "const": "EXTERNAL_OBSERVED_EVIDENCE"
        },
        "scope_fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "project_fact_fingerprint": {
          "oneOf": [
            {"$ref": "#/$defs/fingerprint"},
            {"type": "null"}
          ]
        },
        "observed_fact_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "referenced_fact_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "claims": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "decision_fingerprint": {
      "$ref": "#/$defs/fingerprint"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "nonEmptyRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "statement", "evidence_refs"],
      "properties": {
        "classification": {
          "type": "string"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    },
    "levelDetail": {
      "allOf": [
        {"$ref": "#/$defs/detail"},
        {
          "properties": {
            "classification": {
              "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "UNKNOWN"]
            }
          }
        }
      ]
    }
  }
}
