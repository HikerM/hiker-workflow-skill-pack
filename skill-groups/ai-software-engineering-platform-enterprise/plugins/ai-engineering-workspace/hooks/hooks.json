{
  "description": "记录Subagent生命周期并注入工作区边界。",
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/agent_event.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\agent_event.py\"",
            "statusMessage": "加载子Agent工作区边界",
            "additionalContextLimit": 900
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/agent_event.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\agent_event.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
